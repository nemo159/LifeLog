<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <!-- 스플래시 아이콘 설정 -->
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <!-- 스플래시 배경색 설정 -->
        <item name="windowSplashScreenBackground">@color/white</item>
        <!-- 스플래시 이후에 적용될 앱의 메인 테마 -->
        <item name="postSplashScreenTheme">@style/Theme.LifeLog</item>
    </style>

    <!--
      앱 전체 기본 테마
      - Compose(Material3)와 함께 사용해도 문제 없습니다.
      - NoActionBar: Compose에서 TopAppBar를 쓰는 구조이므로 기본 ActionBar는 불필요
    -->
    <!--    <style name="Theme.LifeLog" parent="Theme.MaterialComponents.DayNight.NoActionBar"/>-->
    <style name="Theme.LifeLog" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- 필요 시 상태바/내비게이션바 색상 등을 여기서 통제할 수 있습니다 -->
        <!-- 예: <item name="android:statusBarColor">@android:color/transparent</item> -->
    </style>

</resources>
